# Copy to ui/.env to override the defaults. All values are optional.

# Port and address the server listens on. Keep 127.0.0.1 and reach it from
# other devices with `tailscale serve 3000` instead of binding to 0.0.0.0.
PORT=3000
HOST=127.0.0.1

# Path to the Claude Code CLI if `claude` is not on the PATH of the shell
# that starts the server.
CLAUDE_BIN=claude

# Never set ANTHROPIC_API_KEY. With it set, Claude Code bills the API
# instead of the Max plan. The server also strips it from every run.
