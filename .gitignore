# Python
.venv/
__pycache__/
*.pyc

# Secrets: every .env variant is private, only the blank templates are committed
.env*
!.env.example
!.env.example.old
.claude/settings.local.json
CLAUDE.local.md
.agents/credentials.json
.agents/mcp_config.json

# Playwright MCP traces and page snapshots saved at the repo root
.playwright-mcp/
/*.yml

# Keep the input/ and output/ folders in git, but not what is inside them
output/*
!output/.gitkeep
input/*
!input/profile.example.yaml
!input/resumes/
input/resumes/*
!input/resumes/.gitkeep
scratch/

# macOS
.DS_Store
