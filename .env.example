# Gemini
GEMINI_API_KEY=replace_me

# Apollo
APOLLO_API_KEY=replace_me

# Generic people-search provider
# Example:
# SEARCH_API_URL=https://api.tavily.com/search
SEARCH_API_URL=
SEARCH_API_KEY=

# Optional override if your search provider expects a different auth header
SEARCH_API_AUTH_HEADER=Authorization
